# ============================================================
# 3D ULPIN — Local Development Configuration
# ============================================================

# PostgreSQL / PostGIS
POSTGRES_DB=ulpin
POSTGRES_USER=ulpin
POSTGRES_PASSWORD=change_me

# Backend and ingestion pipeline database connection.
DATABASE_URL=postgresql://ulpin:change_me@localhost:5432/ulpin

# Comma-separated origins allowed to call FastAPI.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173